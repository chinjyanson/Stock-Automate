# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Node
node_modules/
.next/
# Verification builds redirected via NEXT_DIST_DIR, so a build can be checked
# without corrupting a running dev server's .next.
.next-*/
out/
.turbo/
coverage/
playwright-report/
test-results/

# Secrets — never commit real credentials
.env
.env.local
.env.*.local
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Runtime artifacts
logs/
*.log

# Cached market-data panels for the backtests. Re-fetchable in a couple of
# minutes and tens of megabytes; the *constituent list* beside them is committed
# because it records which universe a published result was measured on.
apps/api/data/*.npz
# SEC company facts and split histories, cached by app.backtest.fundamentals.
# Nineteen megabytes distilled from about two gigabytes of EDGAR, rebuilt by
# re-running with no cache present. The *filing dates* inside are what make a
# result reproducible, and those come back identical from EDGAR every time.
apps/api/data/sec_facts.json
apps/api/data/sec_splits.json
apps/api/data/pit_*.json
